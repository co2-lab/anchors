---
// Override do Header do Starlight — mesma composição, sem ThemeSelect (a
// landing não tem toggle de tema; as docs seguem o mesmo padrão) e com o
// seletor de idioma como lista inline (PT · EN), igual à landing, em vez de
// dropdown.
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const locales = Object.entries(config.locales ?? {});
const currentLocale = Astro.locals.starlightRoute.locale ?? 'root';

// Troca só o segmento de locale no início do path: `/en/docs/x` <-> `/docs/x`.
// O locale raiz não tem prefixo (ver astro.config.mjs: defaultLocale: 'root').
function localizedPathname(locale: string): string {
	const path = Astro.url.pathname;
	const withoutLocale = path.replace(new RegExp(`^/(${Object.keys(config.locales ?? {}).filter((l) => l !== 'root').join('|')})/`), '/');
	return locale === 'root' ? withoutLocale : `/${locale}${withoutLocale}`;
}
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		{locales.length > 1 && (
			<span class="lang-list">
				{locales.map(([code], i) => (
					<>
						{i > 0 && ' · '}
						<a href={localizedPathname(code)} class={code === currentLocale ? 'active' : ''}>
							{(code === 'root' ? config.defaultLocale?.lang ?? code : code).slice(0, 2).toUpperCase()}
						</a>
					</>
				))}
			</span>
		)}
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}
	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-hairline);
	}
	.lang-list {
		font-size: var(--text-xs);
		color: var(--text-faint);
		font-family: var(--font-mono);
		white-space: nowrap;
	}
	.lang-list a {
		color: var(--text-faint);
		border-bottom: none;
	}
	.lang-list a:hover {
		color: var(--text-primary);
	}
	.lang-list a.active {
		color: var(--text-accent);
		font-weight: 700;
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				1fr
				auto;
			align-content: center;
		}
	}
</style>
